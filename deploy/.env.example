# server-setup.sh creates deploy/.env from these on first run. Never commit the real file.

# Public hostname. Defaults to a free sslip.io name built from the server's IP.
SITE_ADDRESS=stepfree.203-0-113-10.sslip.io

# Generate with: openssl rand -hex 32
DB_PASSWORD=

# Optional. A free key from https://api-portal.tfl.gov.uk raises TfL's limit from 50 to 500 requests/minute.
TFL_APP_KEY=

# Optional. Without SMTP, alerts still appear in the app.
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=
