# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# --- Database (used by docker-compose and the backend) ---
POSTGRES_DB=stepfree
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/stepfree
DB_USERNAME=stepfree
DB_PASSWORD=change-me

# --- TfL Unified API ---
# Optional. Without a key TfL allows 50 requests/minute; a free key from
# https://api-portal.tfl.gov.uk raises this to 500/minute.
TFL_APP_KEY=

# --- CORS ---
# Comma-separated exact origins. Leave empty when the frontend proxies /api (the default).
CORS_ALLOWED_ORIGINS=

# --- Sessions ---
# Set to true when served over HTTPS (production) so the session cookie is never sent in clear.
SESSION_COOKIE_SECURE=false

# --- Monitoring ---
# The in-process scheduler that checks saved journeys against TfL.
MONITORING_ENABLED=true
MONITORING_INTERVAL=2m

# --- Email alerts ---
# Defaults point at Mailpit from docker-compose. In production use a real SMTP provider.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=alerts@stepfree.local
# Used for links in emails.
APP_BASE_URL=http://localhost:5173

# --- Monitoring trigger (production on a host that sleeps) ---
# Enables POST /internal/monitoring/run for the GitHub Actions wake-up workflow. Use a long random
# value, e.g. `openssl rand -hex 32`, and store the same value as the MONITORING_TRIGGER_TOKEN secret.
MONITORING_TRIGGER_TOKEN=
